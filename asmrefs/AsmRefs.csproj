<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints the assemblies a compiled assembly references in its metadata. No NuGet packages:
       System.Reflection.Metadata and System.Text.Json ship with .NET. Built and run by level1.sh (deps step). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
